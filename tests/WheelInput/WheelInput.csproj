<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">D:\Program Files (x86)\Steam\steamapps\common\artofrally</GameDir>
    <!-- DriveTrial.Sample's clutch and H-pattern fields are filled only by the mod's ShimDrive postfix, which needs
         the game's car types and is not linked here. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ShimInput/BridgeTests.cs" Link="BridgeTests.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/Shim/*.cs" Link="Shim/%(Filename)%(Extension)" />
    <Compile Include="../../src/ArtOfSimRally.Mod/Shifter.cs" Link="Shifter.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/SharedInputStartup.cs" Link="SharedInputStartup.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/FfbSelection.cs" Link="FfbSelection.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/WheelInput.cs" Link="WheelInput.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/WheelInput.Shim.cs" Link="WheelInput.Shim.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/WheelInput.Binding.cs" Link="WheelInput.Binding.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/WheelInput.Calibration.cs" Link="WheelInput.Calibration.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/WheelInput.GameButtons.cs" Link="WheelInput.GameButtons.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/GameButtonInput.cs" Link="GameButtonInput.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/TransmissionInput.cs" Link="TransmissionInput.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/DeferredSave.cs" Link="DeferredSave.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/Settings.cs" Link="Settings.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/SettingsPersistence.cs" Link="SettingsPersistence.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/SettingsCommit.cs" Link="SettingsCommit.cs" />
    <!-- The real shared binding host that WheelInput.Shim and SharedInputStartup call, with the same closure as
         tests/SharedBindings (BindingSampleClock comes with Shim/*.cs above). -->
    <Compile Include="../../src/ArtOfSimRally.Mod/SharedBindingCaptureHost.cs" Link="SharedBindingCaptureHost.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/SharedBindingDraft.cs" Link="SharedBindingDraft.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/Toolkit/Input/*.cs" Link="Toolkit/%(Filename)%(Extension)" />
    <Compile Include="../../src/ArtOfSimRally.Mod/Toolkit/Ui/SettingsPresentation.cs" Link="SettingsPresentation.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/Toolkit/Ui/BindingSaveStatus.cs" Link="BindingSaveStatus.cs" />
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameDir)/artofrally_Data/Managed/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityModManager"><HintPath>../../lib/umm/UnityModManager.dll</HintPath></Reference>
  </ItemGroup>
</Project>
