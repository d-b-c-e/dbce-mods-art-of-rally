<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">D:\Program Files (x86)\Steam\steamapps\common\artofrally</GameDir>
    <CameraSourceRoot Condition="'$(CameraSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../src/ArtOfSimRally.Mod</CameraSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(CameraSourceRoot)/CameraTuner.cs" Link="CameraTuner.cs" />
    <Compile Include="$(CameraSourceRoot)/ChaseFov.cs" Link="ChaseFov.cs" />
    <Compile Include="$(CameraSourceRoot)/CameraMountMemory.cs" Link="CameraMountMemory.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/CameraCarIdentity.cs" Link="CameraCarIdentity.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/ChasePoseStore.cs" Link="ChasePoseStore.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/CameraMountFit.cs" Link="CameraMountFit.cs" />
    <Compile Include="$(CameraSourceRoot)/CameraKeys.cs" Link="CameraKeys.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/NativeKeyboardBindings.cs" Link="NativeKeyboardBindings.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/DeferredSave.cs" Link="DeferredSave.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/Settings.cs" Link="Settings.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/SettingsPersistence.cs" Link="SettingsPersistence.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/SettingsCommit.cs" Link="SettingsCommit.cs" />
    <!-- Production stores/dispatch/serialization; managed scene/input/clock/host doubles, no Unity scene. -->
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameDir)/artofrally_Data/Managed/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityModManager"><HintPath>../../lib/umm/UnityModManager.dll</HintPath></Reference>
  </ItemGroup>
</Project>
