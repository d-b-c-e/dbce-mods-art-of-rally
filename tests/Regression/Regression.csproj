    <Compile Include="../../src/ArtOfSimRally.Mod/LogFiles.cs" Link="LogFiles.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/DeferredSave.cs" Link="DeferredSave.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/SettingsPersistence.cs" Link="SettingsPersistence.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/Settings.cs" Link="Settings.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/SettingsViewPolicy.cs" Link="SettingsViewPolicy.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/FfbSelection.cs" Link="FfbSelection.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/NativeDiagnostics.cs" Link="NativeDiagnostics.cs" />
    <!-- Private test output only; never packaged. Uses the installed game's real Mathf. -->
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameDir)/artofrally_Data/Managed/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="Dbce.Wheel.Ffb"><HintPath>../../lib/toolkit/dotnet/Dbce.Wheel.Ffb.dll</HintPath></Reference>
    <Reference Include="UnityModManager"><HintPath>../../lib/umm/UnityModManager.dll</HintPath></Reference>
