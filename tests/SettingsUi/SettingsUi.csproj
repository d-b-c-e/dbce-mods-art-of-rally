<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">D:\Program Files (x86)\Steam\steamapps\common\artofrally</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../docs/SETTINGS-INVENTORY.json" Link="SETTINGS-INVENTORY.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../src/ArtOfSimRally.Mod/Triple/Settings.cs" Link="Triple/Settings.cs" />
    <Compile Remove="Stubs.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/Toolkit/Ui/SettingsPresentation.cs" Link="Shared/SettingsPresentation.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/Settings.cs" Link="Settings.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/SettingsPersistence.cs" Link="SettingsPersistence.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/SettingsViewPolicy.cs" Link="SettingsViewPolicy.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/SettingsMigration.cs" Link="SettingsMigration.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/FfbSelection.cs" Link="FfbSelection.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/Main.SettingsUi.cs" Link="Main.SettingsUi.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/DraftCloseGuard.cs" Link="DraftCloseGuard.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/MenuInputBarrier.cs" Link="MenuInputBarrier.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/StockUiInput.cs" Link="StockUiInput.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/SettingsDisplayPolicy.cs" Link="SettingsDisplayPolicy.cs" />
    <Reference Include="0Harmony"><HintPath>../../lib/umm/0Harmony.dll</HintPath></Reference>
    <Compile Include="../../src/ArtOfSimRally.Mod/WheelInput.Binding.cs" Link="WheelInput.Binding.cs" />
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameDir)/artofrally_Data/Managed/UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>
  <!-- Triple.Settings overrides GetPath; adapt the existing loader fixture without changing production source. -->
  <Target Name="InventoryLoaderFixture" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <InventoryStubs>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/Stubs.cs').Replace('public static string GetPath', 'public virtual string GetPath').Replace('public ModInfo Info=new();', 'public string Path = &quot;fixture&quot;; public ModInfo Info=new();'))</InventoryStubs>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)InventoryStubs.cs" Lines="$([MSBuild]::Escape($(InventoryStubs)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)InventoryStubs.cs" />
    </ItemGroup>
  </Target>
</Project>
