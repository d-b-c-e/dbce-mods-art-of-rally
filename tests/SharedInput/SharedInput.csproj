<Project Sdk="Microsoft.NET.Sdk">
  <!-- The shared profile route with its production sources linked unchanged: readers, startup, bridge, consumer,
       button edges, car-input and Rewired postfixes, force feedback target selection. Device, Rewired and game
       types are stubs (Stubs.cs). Each scenario attaches the process-wide consumer, so build.ps1 runs one per process. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">D:\Program Files (x86)\Steam\steamapps\common\artofrally</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ShimInput/BridgeTests.cs" Link="BridgeTests.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/Shim/*.cs" Link="Shim/%(Filename)%(Extension)" />
    <Compile Include="../../src/ArtOfSimRally.Mod/SharedInputStartup.cs" Link="SharedInputStartup.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/NativeDiagnostics.cs" Link="NativeDiagnostics.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/StoreProfileSource.cs" Link="StoreProfileSource.cs" />
    <Compile Include="../../lib/toolkit/shared/mod/DbceModFile.cs;../../lib/toolkit/shared/mod/DbceStore.cs;../../lib/toolkit/shared/mod/DbceStoreControls.cs" Link="Toolkit/%(Filename)%(Extension)" />
    <Compile Include="../../src/ArtOfSimRally.Mod/FfbSelection.cs" Link="FfbSelection.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/WheelReaders.cs" Link="WheelReaders.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/ProfileButtons.cs" Link="ProfileButtons.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/CarInputPatch.cs" Link="CarInputPatch.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/GameButtonInput.cs" Link="GameButtonInput.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/TransmissionInput.cs" Link="TransmissionInput.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/Settings.cs" Link="Settings.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/SettingsPersistence.cs" Link="SettingsPersistence.cs" />
    <!-- The real shared binding host that WheelReaders and SharedInputStartup call, with the same closure as
         tests/SharedBindings (BindingSampleClock comes with Shim/*.cs above). -->
    <Compile Include="../../src/ArtOfSimRally.Mod/SharedBindingCaptureHost.cs" Link="SharedBindingCaptureHost.cs" />
    <Compile Include="../../src/ArtOfSimRally.Mod/SharedBindingDraft.cs" Link="SharedBindingDraft.cs" />
    <Compile Include="../../lib/toolkit/shared/input/BindingCapture.cs;../../lib/toolkit/shared/input/BindingCaptureFlow.cs;../../lib/toolkit/shared/input/BindingEditorContract.cs;../../lib/toolkit/shared/input/BindingEditorPolicy.cs;../../lib/toolkit/shared/input/ControlBinding.cs;../../lib/toolkit/shared/input/ControlProfileDocument.cs;../../lib/toolkit/shared/input/ControlProfileDraft.cs;../../lib/toolkit/shared/input/DeclaredControlExtras.cs" Link="Toolkit/%(Filename)%(Extension)" />
    <Compile Include="../../lib/toolkit/shared/ui/SettingsPresentation.cs" Link="SettingsPresentation.cs" />
    <Compile Include="../../lib/toolkit/shared/ui/BindingSaveStatus.cs" Link="BindingSaveStatus.cs" />
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameDir)/artofrally_Data/Managed/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityModManager"><HintPath>../../lib/umm/UnityModManager.dll</HintPath></Reference>
  </ItemGroup>
</Project>
