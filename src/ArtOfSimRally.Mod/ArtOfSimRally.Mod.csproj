<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../Version.props" />

  <!--
    net48 to match Unity Mod Manager's own assemblies, which are built against
    .NET Framework 4.8; referencing them from 4.7.2 fails to resolve. Unity
    2019.4's Mono runs both. The game assemblies are
    referenced straight from the local Steam install and are never committed -
    they are copyrighted and large. Override GameDir if your install differs.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ArtOfSimRally.Mod</AssemblyName>
    <RootNamespace>ArtOfSimRally.Mod</RootNamespace>
    <!-- Unity assemblies are not deterministic-friendly and pull no NuGet deps. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">D:\Program Files (x86)\Steam\steamapps\common\artofrally</GameDir>
    <ManagedDir>$(GameDir)\artofrally_Data\Managed</ManagedDir>
    <!-- UnityModManager.dll and its Harmony are extracted into lib/umm (git-ignored). -->
    <UmmDir>$(MSBuildThisFileDirectory)..\..\lib\umm</UmmDir>
  </PropertyGroup>

  <!--
    The Forza encoder and the native FFB layer come from dbce-wheel-mod-toolkit,
    vendored as built artifacts under lib\toolkit (pinned by lib\toolkit\VERSION,
    refreshed with tools\Sync-Toolkit.ps1). Private=true: the assembly ships
    beside the mod.
  -->
  <ItemGroup>
    <Reference Include="Dbce.Wheel.Ffb">
      <HintPath>..\..\lib\toolkit\dotnet\Dbce.Wheel.Ffb.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Dbce.Wheel.Telemetry">
      <HintPath>..\..\lib\toolkit\dotnet\Dbce.Wheel.Telemetry.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!--
    Bake the vendored toolkit pin into the assembly so a support file can report
    it. It cannot be read at runtime: lib\toolkit\VERSION is a build-time file
    and is not shipped.

    This is not the same number as the native DLL's own GetWheelFfbVersion().
    That one moves only when native\wheelffb changes, so a mod pinned at toolkit
    v0.7.1 correctly reports a native layer of 0.4.0 - nothing in the native
    layer moved between them. Reporting only one of the two made a normal
    install look like a stale DLL.
  -->
  <PropertyGroup>
    <_ToolkitVersionFile>$(MSBuildThisFileDirectory)..\..\lib\toolkit\VERSION</_ToolkitVersionFile>
    <_ToolkitVersionRaw Condition="Exists('$(_ToolkitVersionFile)')">$([System.IO.File]::ReadAllText($(_ToolkitVersionFile)))</_ToolkitVersionRaw>
    <ToolkitPin Condition="'$(_ToolkitVersionRaw)' != ''">$(_ToolkitVersionRaw.Split('%0A')[0].Trim())</ToolkitPin>
    <ToolkitPin Condition="'$(ToolkitPin)' == ''">(unknown)</ToolkitPin>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ToolkitPin</_Parameter1>
      <_Parameter2>$(ToolkitPin)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Private=false everywhere: these must NOT be copied to the output folder. The
    game already has them loaded, and shipping a second copy of UnityEngine or
    Assembly-CSharp alongside the plugin is a classic way to get type-identity
    errors at runtime.
  -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rewired_Core">
      <HintPath>$(ManagedDir)\Rewired_Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityModManager">
      <HintPath>$(UmmDir)\UnityModManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(UmmDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Triple screens (formerly the DbceTripleScreenArtOfRally mod, 0.3.12). Core is
    the projection math, Protocol the optimizer layout/status contract; both
    ship beside the mod. Triple/ holds the game-side rendering code.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Dbce.TripleScreen.Core\Dbce.TripleScreen.Core.csproj" />
    <ProjectReference Include="..\Dbce.TripleScreen.Protocol\Dbce.TripleScreen.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(ManagedDir)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Postprocessing.Runtime">
      <HintPath>$(ManagedDir)\Unity.Postprocessing.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AwesomeTechnologies.VegetationStudioPro.Runtime">
      <HintPath>$(ManagedDir)\AwesomeTechnologies.VegetationStudioPro.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
